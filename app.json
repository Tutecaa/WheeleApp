{
  "expo": {
    "name": "WHEEL-E",
    "slug": "wheel-e",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wheele",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.wheele.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B8A4C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "WHEEL-E usa tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cbbf7d03-b33e-41ae-9335-60ade2d73760"
      }
    },
    "owner": "juliaan02"
  }
}
